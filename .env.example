# ---------------------------------------------------------------------------
# Copy to .env.local for development, and set the same values in your Vercel
# project settings for production. Never commit real values.
# ---------------------------------------------------------------------------

# Absolute origin, no trailing slash. Used for canonical URLs, Open Graph tags,
# the sitemap and robots.txt. Defaults to https://ethanlangley.dev.
NEXT_PUBLIC_SITE_URL=https://ethanlangley.dev

# ---------------------------------------------------------------------------
# Scheduling (optional)
# ---------------------------------------------------------------------------
# External booking link for the 20-minute discovery call — Cal.com, SavvyCal,
# Calendly or similar. Must start with http:// or https://.
# When unset, every "Book a discovery call" button routes to the contact form
# instead, so nothing breaks.
NEXT_PUBLIC_SCHEDULING_URL=

# ---------------------------------------------------------------------------
# Contact form email delivery (optional)
# ---------------------------------------------------------------------------
# Delivery uses the Resend REST API. Without RESEND_API_KEY and
# CONTACT_FROM_EMAIL, the form still validates and accepts submissions, logs
# them server-side, and tells the visitor to email directly as a fallback.
#
# 1. Create an API key at https://resend.com/api-keys
# 2. Verify the sending domain you use for CONTACT_FROM_EMAIL
RESEND_API_KEY=
# Must be an address on a domain verified in Resend.
CONTACT_FROM_EMAIL=website@ethanlangley.dev
# Where enquiries are delivered. Defaults to the address in src/content/site.ts.
CONTACT_TO_EMAIL=Ethan.langley.dev@gmail.com

# ---------------------------------------------------------------------------
# Analytics (optional, off by default)
# ---------------------------------------------------------------------------
# Vercel Analytics. Set to "true" to enable. Custom conversion events require
# a Vercel plan that supports them; page views work on any plan.
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# Plausible, as an alternative or in addition. Set to the site domain you
# registered in Plausible, e.g. ethanlangley.dev. Leave empty to disable.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
